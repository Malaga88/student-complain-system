# Copy this file to .env and fill in your own values.

# Local MongoDB:   mongodb://127.0.0.1:27017/complaint_system
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/complaint_system
MONGODB_URI=mongodb://127.0.0.1:27017/complaint_system

# Any long random string - used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
