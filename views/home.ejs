<% locals.title = 'Welcome' %>
<%- include('partials/header') %>

  <div class="hero">
    <p class="eyebrow">Abubakar Tafawa Balewa University</p>
    <h1>Say what's wrong. Get it looked at.</h1>
    <p class="lede">
      A place to report hostel, academic, and welfare complaints without
      writing a letter or standing outside an office door. Submit a complaint,
      then check back any time to see what's being done about it.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/register">Report a complaint</a>
      <a class="btn btn-ghost" href="/login">Log in</a>
    </div>

    <div class="case-strip">
      <div>
        <span class="num">1</span>
        <span class="label">Submit online, from any device</span>
      </div>
      <div>
        <span class="num">2</span>
        <span class="label">Track its status at any time</span>
      </div>
      <div>
        <span class="num">3</span>
        <span class="label">Hear back from staff directly</span>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
